{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'vendor already committed'",
  "buildCommand": "echo 'no build needed'",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/build/(.*)",  "dest": "/build/$1" },
    { "src": "/css/(.*)",    "dest": "/css/$1" },
    { "src": "/js/(.*)",     "dest": "/js/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/(.*)",        "dest": "/api/index.php" }
  ]
}